# ID da planilha Google Sheets oficial do Mapa da Mulher Carioca.
# Exemplo: https://docs.google.com/spreadsheets/d/ESTE_E_O_ID/edit
SPREADSHEET_ID=

# Recomendado na Vercel: cole o JSON completo da Service Account.
# A conta precisa ter acesso de LEITOR à planilha.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternativa: JSON da Service Account codificado em base64.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
